#include <winuser.h>

1 ICON "../icon.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "SurvivalFrench RP"
      VALUE "FileDescription", "SurvivalFrench Launcher"
      VALUE "FileVersion", "2.0.0"
      VALUE "ProductName", "SurvivalFrench Launcher"
      VALUE "ProductVersion", "2.0.0"
      VALUE "OriginalFilename", "SurvivalFrench-Launcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
